# Production environment template
# Copy to .env.prod and fill in all values. Never commit .env.prod to git.

# Django
SECRET_KEY=                    # Generate: openssl rand -base64 48
DEBUG=false
ALLOWED_HOSTS=                  # Comma-separated: api.yourdomain.com,yourdomain.com,YOUR_DROPLET_IP

# PostgreSQL (DB_HOST must be 'db' when using Docker Compose)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# PostgreSQL container - must match DB_* above
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# CORS - comma-separated frontend URLs that will call this API
CORS_ALLOWED_ORIGINS=           # e.g. https://yourdomain.com,https://app.yourdomain.com
