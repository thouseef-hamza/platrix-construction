# Production environment template
# Copy to .env.prod and fill in all values. Never commit .env.prod to git.

# Django
SECRET_KEY=                    # Generate: openssl rand -base64 48
DEBUG=false
ALLOWED_HOSTS=                  # Comma-separated: api.yourdomain.com,yourdomain.com,YOUR_DROPLET_IP

# PostgreSQL (DB_HOST must be 'db' when using Docker Compose)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# PostgreSQL container - must match DB_* above
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# CORS - comma-separated frontend URLs that will call this API
CORS_ALLOWED_ORIGINS=           # e.g. https://yourdomain.com,https://app.yourdomain.com

# CSRF - origins allowed for CSRF (Django admin, forms). Required for HTTPS.
# Include your API URL and any frontend URLs that post to the API.
CSRF_TRUSTED_ORIGINS=           # e.g. https://api.yourdomain.com,https://yourdomain.com

# Security (set true when behind HTTPS/TLS)
USE_HTTPS=false                 # Set true when using SSL (enables secure cookies, redirects)

# Optional: JWT token lifetimes
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
